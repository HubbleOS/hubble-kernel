ENTRY(_start)

SECTIONS
{
    /* Начало программы в виртуальном адресе 0x400000 */
    . = 0x400000;

    /* Текст (код) */
    .text : {
        *(.text*)
        *(.rodata*)   /* можно сюда включить константы */
    }

    /* Данные */
    .data : {
        *(.data*)
    }

    /* BSS */
    .bss : {
        *(.bss*)
        *(COMMON)
    }
}
